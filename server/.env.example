PORT=4000
DATABASE_URL=postgres://smartshop:smartshop@localhost:5433/smartshop

# Danh sách origin cho phép (phân cách bằng dấu phẩy). "*" = cho phép tất cả (chỉ dùng khi dev).
CORS_ORIGIN=*

# Chống quét trùng: cùng 1 SKU từ cùng 1 điện thoại trong khoảng này (ms) sẽ bị bỏ qua.
SCAN_COOLDOWN_MS=1500
